<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>com.erik.tunarr-pip.daemon</string>
 <key>ProgramArguments</key><array><string>/opt/homebrew/bin/python3</string><string>__REPO__/tunarrd/tunarrd.py</string></array>
 <key>KeepAlive</key><true/>
 <key>RunAtLoad</key><true/>
 <key>ThrottleInterval</key><integer>5</integer>
 <key>StandardErrorPath</key><string>__HOME__/Library/Logs/tunarr-pip-daemon.log</string>
 <key>StandardOutPath</key><string>__HOME__/Library/Logs/tunarr-pip-daemon.log</string>
</dict></plist>
